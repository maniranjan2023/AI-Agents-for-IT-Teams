# Copy to .env and fill in values. Never commit .env.

# --- Neon Postgres (https://neon.tech/docs/connect/connect-from-any-app)
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# --- Flask
SECRET_KEY=change-this-to-a-long-random-string
FLASK_RUN_PORT=5000

# --- Admin panel URL
# For Browser Use CLOUD: must be reachable from the public internet (not http://127.0.0.1).
# Use ngrok, Cloudflare Tunnel, Railway, etc. Example: https://abc123.ngrok-free.app
ADMIN_BASE_URL=https://your-public-url.example

# --- Browser Use Cloud (https://docs.browser-use.com/cloud/quickstart)
# Create key: https://cloud.browser-use.com/settings?tab=api-keys&new=1
BROWSER_USE_API_KEY=bu_your_key_here

# Optional model (see https://docs.browser-use.com/cloud/faq — default is Claude Sonnet on Cloud)
# BROWSER_USE_MODEL=claude-sonnet-4.6

# Optional: auto-open Browser Use live view in your browser (or use: python -m agent "..." --open-live)
# AGENT_AUTO_OPEN_LIVE=1

# --- OpenAI — planner only (structured JSON plan before Cloud run)
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
